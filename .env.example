# Copy to .env (local) or set these in Render. Never commit .env.
# --- AI model: set ONE (Gemini has a free tier: https://aistudio.google.com) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# --- Twilio (free trial) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=            # your Twilio number, e.g. +1415XXXXXXX
TWILIO_API_KEY_SID=       # starts with SK
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=     # starts with AP
PUBLIC_URL=               # your public https URL (Render sets RENDER_EXTERNAL_URL automatically)
# TTS_VOICE=Polly.Aditi
